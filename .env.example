# CSV Excel Converter - Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================================
# Application Settings
# ===========================================

# Base URL for the application (used for sitemap, Open Graph, etc.)
NEXT_PUBLIC_BASE_URL=https://csv-excel-converter.com

# ===========================================
# Rate Limiting (optional)
# ===========================================

# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Redis Rate Limiting - Upstash (optional)
# ===========================================
# When configured, uses distributed Redis rate limiting for multi-instance deployments
# If not configured, falls back to in-memory rate limiting

# Upstash Redis REST URL
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io

# Upstash Redis REST Token
# UPSTASH_REDIS_REST_TOKEN=xxx

# ===========================================
# Analytics (optional)
# ===========================================

# Google Analytics Measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# Error Tracking - Sentry (optional)
# ===========================================

# Sentry DSN for error tracking (required for Sentry to work)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Sentry organization slug (for source map uploads)
# SENTRY_ORG=your-org

# Sentry project name (for source map uploads)
# SENTRY_PROJECT=csv-excel-converter

# Sentry auth token (for CI/CD source map uploads)
# SENTRY_AUTH_TOKEN=sntrys_xxx

# ===========================================
# Admin Dashboard (optional)
# ===========================================

# Token for accessing the admin stats API endpoint
# If not set, the admin dashboard is accessible without authentication
# ADMIN_TOKEN=your-secret-admin-token
