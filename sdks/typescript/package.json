{
  "name": "@mwm/csv-converter-sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the CSV Excel Converter API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
