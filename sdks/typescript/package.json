  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mahmoodhamdi/CSV-Excel-Converter",
    "directory": "sdks/typescript"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
