  "privacy": {
    "title": "Privacy Policy",
    "lastUpdated": "Last updated: February 2026",
    "dataCollection": {
      "title": "Data Collection",
      "content": "We do not collect, store, or transmit any of your uploaded files or converted data. All file processing happens entirely in your browser or temporarily on our server during conversion, and data is immediately discarded after processing."
    },
    "dataProcessing": {
      "title": "Data Processing",
      "content": "Files uploaded for conversion are processed in real-time and are not stored on our servers. We do not analyze, mine, or retain any content from your files. API requests are processed and responses are returned immediately without data retention."
    },
    "cookies": {
      "title": "Cookies & Local Storage",
      "content": "We use local storage only to save your preferences (theme, language) and conversion history. No tracking cookies are used. You can clear your local storage at any time through your browser settings."
    },
    "thirdParty": {
      "title": "Third-Party Services",
      "content": "We may use analytics services to understand usage patterns. These services collect anonymous, aggregated data only. No personal information or file contents are shared with third parties."
    },
    "security": {
      "title": "Security",
      "content": "We implement industry-standard security measures including input validation, Content Security Policy headers, rate limiting, and protection against common web vulnerabilities (XSS, SQL injection, XXE attacks)."
    }
  },
  "terms": {
    "title": "Terms of Service",
    "lastUpdated": "Last updated: February 2026",
    "usage": {
      "title": "Acceptable Use",
      "content": "This service is provided for legitimate data conversion purposes. You agree not to use the service for any illegal activities, to attempt to circumvent rate limits, or to deliberately upload malicious files designed to exploit the system."
    },
    "service": {
      "title": "Service Availability",
      "content": "We strive to maintain high availability but do not guarantee uninterrupted service. The service is provided on an as-is basis. We reserve the right to modify, suspend, or discontinue the service at any time."
    },
    "limitations": {
      "title": "Limitations",
      "content": "File uploads are limited to 50MB per file. API usage is rate-limited to 100 requests per minute. Batch conversions are limited to 10 files at a time. These limits may be adjusted without notice."
    },
